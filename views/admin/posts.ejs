<%- include("../partials/header") %>

<main class="max-w-6xl mx-auto px-4 py-10">
  <div class="flex items-baseline justify-between mb-4">
    <h1 class="text-2xl font-semibold text-slate-900">Posts (admin)</h1>
    
    <div class="flex gap-3">
  <a href="/admin/posts/new"
    class="text-xs bg-blue-600 text-white px-3 py-1.5 rounded-full hover:bg-blue-700 transition">
    + Nuevo post
  </a>
  <a href="/admin" class="text-xs text-blue-600 hover:text-blue-800">
    ← Volver al panel
  </a>
</div>

      ← Volver al panel
    </a>
  </div>

  <% if (!posts || posts.length === 0) { %>
    <p class="text-sm text-slate-500">No hay posts para mostrar.</p>
  <% } else { %>
    <div class="overflow-x-auto bg-white border border-slate-100 rounded-2xl shadow-sm">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Título</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Slug</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Estado</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Publicado</th>
            <!-- ↓ NUEVO -->
            <th class="text-left px-4 py-2 font-medium text-slate-600">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% posts.forEach((post) => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/60">
              <td class="px-4 py-2"><%= post.title %></td>
              <td class="px-4 py-2 text-xs text-slate-500"><%= post.slug %></td>
              <td class="px-4 py-2 text-xs"><%= post.status %></td>
              <td class="px-4 py-2 text-xs text-slate-500">
                <%= post.published_at ? new Date(post.published_at).toLocaleString("es-ES") : "-" %>
              </td>
              <!-- ↓ NUEVO -->
              <td class="px-4 py-2 flex items-center gap-2">
                <a
                  href="/admin/posts/<%= post.id %>/edit"
                  class="px-2 py-1 rounded-full border border-slate-200 text-slate-600 hover:bg-slate-100 transition text-xs"
                >
                  Editar
                </a>
                <form
                  method="post"
                  action="/admin/posts/<%= post.id %>/delete"
                  onsubmit="return confirm('¿Eliminar este post?');"
                >
                  <button
                    type="submit"
                    class="px-2 py-1 rounded-full border border-red-200 text-red-600 hover:bg-red-50 transition text-xs"
                  >
                    Eliminar
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include("../partials/footer") %>