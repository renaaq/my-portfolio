<%- include("../partials/header") %>

<main class="max-w-6xl mx-auto px-4 py-10">
  <div class="flex items-baseline justify-between mb-4">
    <h1 class="text-2xl font-semibold text-slate-900">Mensajes</h1>
    <a href="/admin" class="text-xs text-blue-600 hover:text-blue-800">
      ← Volver al panel
    </a>
  </div>

  <% if (!messages || messages.length === 0) { %>
    <p class="text-sm text-slate-500">No hay mensajes para mostrar.</p>
  <% } else { %>
    <div class="overflow-x-auto bg-white border border-slate-100 rounded-2xl shadow-sm">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Nombre</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Email</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Asunto</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Fecha</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Mensaje</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% messages.forEach((item) => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/60">
              <td class="px-4 py-2"><%= item.name %></td>
              <td class="px-4 py-2 text-xs text-slate-500"><%= item.email %></td>
              <td class="px-4 py-2 text-xs"><%= item.subject || "-" %></td>
              <td class="px-4 py-2 text-xs text-slate-500">
                <%= item.created_at ? new Date(item.created_at).toLocaleString("es-ES") : "-" %>
              </td>
              <td class="px-4 py-2 text-xs text-slate-600">
                <%= (item.message || "").slice(0, 80) %><%= (item.message || "").length > 80 ? "..." : "" %>
              </td>
              <td class="px-4 py-2">
                <form action="/admin/messages/<%= item.id %>/delete" method="POST"
                      onsubmit="return confirm('¿Borrar este mensaje?')">
                  <button type="submit"
                    class="text-xs text-red-500 hover:text-red-700 font-medium">
                    Borrar
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include("../partials/footer") %>