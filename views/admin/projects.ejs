<%- include("../partials/header") %>

<main class="max-w-6xl mx-auto px-4 py-10">
  <div class="flex items-baseline justify-between mb-4">
    <h1 class="text-2xl font-semibold text-slate-900">Proyectos (admin)</h1>
    <div class="flex gap-3">
      <a href="/admin/projects/new"
        class="text-xs bg-blue-600 text-white px-3 py-1.5 rounded-full hover:bg-blue-700 transition">
        + Nuevo proyecto
      </a>
      <a href="/admin" class="text-xs text-blue-600 hover:text-blue-800">
        ← Volver al panel
      </a>
    </div>
  </div>

  <% if (!projects || projects.length === 0) { %>
    <p class="text-sm text-slate-500">No hay proyectos para mostrar.</p>
  <% } else { %>
    <div class="overflow-x-auto bg-white border border-slate-100 rounded-2xl shadow-sm">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Título</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Slug</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Destacado</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Creado</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Actualizado</th>
            <th class="text-left px-4 py-2 font-medium text-slate-600">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% projects.forEach((project) => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/60">
              <td class="px-4 py-2"><%= project.title %></td>
              <td class="px-4 py-2 text-xs text-slate-500"><%= project.slug %></td>
              <td class="px-4 py-2 text-xs"><%= project.is_featured ? "Sí" : "No" %></td>
              <td class="px-4 py-2 text-xs text-slate-500">
                <%= project.created_at ? new Date(project.created_at).toLocaleString("es-ES") : "-" %>
              </td>
              <td class="px-4 py-2 text-xs text-slate-500">
                <%= project.updated_at ? new Date(project.updated_at).toLocaleString("es-ES") : "-" %>
              </td>
              <td class="px-4 py-2 flex gap-3">
                <a href="/admin/projects/<%= project.id %>/edit"
                  class="text-xs text-blue-600 hover:text-blue-800 font-medium">
                  Editar
                </a>
                <form action="/admin/projects/<%= project.id %>/delete" method="POST"
                      onsubmit="return confirm('¿Borrar este proyecto?')">
                  <button type="submit"
                    class="text-xs text-red-500 hover:text-red-700 font-medium">
                    Borrar
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include("../partials/footer") %>