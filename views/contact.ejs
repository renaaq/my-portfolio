<%- include("partials/header") %>

<main class="max-w-3xl mx-auto px-4 py-12">
  <h1 class="text-3xl font-semibold text-slate-900 mb-2">Contacto</h1>
  <p class="text-sm text-slate-500 mb-6">
    Contame en qué estás pensando y te respondo lo antes posible.
  </p>

  <% if (successMessage) { %>
    <p class="mb-4 text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg px-3 py-2">
      <%= successMessage %>
    </p>
  <% } %>

  <% if (errorMessage) { %>
    <p class="mb-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2">
      <%= errorMessage %>
    </p>
  <% } %>

  <form method="post" action="/contact" class="space-y-4">
    <div>
      <label for="name" class="block text-xs font-medium text-slate-600 mb-1">Nombre</label>
      <input id="name" name="name" type="text"
             class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"
             value="<%= formData && formData.name ? formData.name : '' %>" required />
    </div>

    <div>
      <label for="email" class="block text-xs font-medium text-slate-600 mb-1">Email</label>
      <input id="email" name="email" type="email"
             class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"
             value="<%= formData && formData.email ? formData.email : '' %>" required />
    </div>

    <div>
      <label for="subject" class="block text-xs font-medium text-slate-600 mb-1">Asunto</label>
      <input id="subject" name="subject" type="text"
             class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"
             value="<%= formData && formData.subject ? formData.subject : '' %>" />
    </div>

    <div>
      <label for="message" class="block text-xs font-medium text-slate-600 mb-1">Mensaje</label>
      <textarea id="message" name="message" rows="5"
                class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"
                required><%= formData && formData.message ? formData.message : '' %></textarea>
    </div>

    <button type="submit"
            class="inline-flex items-center px-4 py-2 rounded-full bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition">
      Enviar mensaje
    </button>
  </form>
</main>

<%- include("partials/footer") %>